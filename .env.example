MDT_DB_PATH=data/mdt.db
MDT_STORAGE_BACKEND=sqlite
# Cloud uses azure_blob with managed identity and private DNS.
# MDT_BLOB_ACCOUNT_URL=https://YOUR-ACCOUNT.blob.core.windows.net
# MDT_BLOB_CONTAINER=mdt-state
MDT_STEP_DELAY=0.65
# Up to seven independent specialist reviews; request pacing is shared across them.
MDT_AZURE_MAX_CONCURRENT_ROLES=3
# Lower only after increasing the model deployment's token/request allocation.
MDT_AZURE_REQUEST_INTERVAL_SECONDS=20
# Required for cloud; generate a cryptographically random value of at least 24 characters.
# MDT_PRESENTER_TOKEN=
# MDT_SECURE_COOKIE=true
# AZURE_OPENAI_ENDPOINT=https://YOUR-ACCOUNT.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
# APPLICATIONINSIGHTS_CONNECTION_STRING=
